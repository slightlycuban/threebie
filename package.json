{
  "name": "threebie",
  "private": true,
  "description": "THREE.js experiments: a rippling mirror sphere",
  "scripts": {
    "serve": "node tests/serve.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test --project=smoke",
    "test:e2e:update": "playwright test --project=smoke --update-snapshots",
    "record": "playwright test --project=record"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
